---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="da">
  <head>
    <BaseHead
      title="Velkommen til Jazzdrengene.dk"
      description="Jazzdrengene.dk er ved at blive opbygget."
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #000;
        --text: #f2f2f2;
        --muted: #d9d9d9;
        --soft: #c8c8c8;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: "Myriad Pro", "Helvetica Neue", Arial, sans-serif;
      }

      body {
        min-height: 100vh;
      }

      main {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.5rem;
      }

      .layout {
        width: 100%;
        max-width: 1250px;
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 3.5rem;
        align-items: center;
      }

      .saxophone {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .saxophone img {
        width: 100%;
        max-width: 220px;
        height: auto;
        display: block;
      }

      .content {
        text-align: left;
      }

      h1 {
        margin: 0;
        font-size: clamp(3rem, 7vw, 5.8rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--text);
      }

      .phone {
        margin-top: 1.25rem;
        font-size: clamp(2rem, 4vw, 3.3rem);
        font-weight: 300;
        color: var(--muted);
        letter-spacing: 0.01em;
      }

      .tagline {
        margin-top: 2.5rem;
        font-size: clamp(1.35rem, 2.6vw, 2.2rem);
        font-weight: 300;
        color: var(--muted);
      }

      .message {
        margin-top: 3rem;
        max-width: 760px;
      }

      .message p {
        margin: 0 0 1rem;
        font-size: 1.15rem;
        line-height: 1.75;
        color: var(--soft);
      }

      a {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }

      a:hover {
        color: #fff;
      }

      @media (max-width: 900px) {
        .layout {
          grid-template-columns: 1fr;
          gap: 2rem;
          text-align: center;
        }

        .content {
          text-align: center;
        }

        .message {
          margin: 2.5rem auto 0;
        }

        .saxophone img {
          max-width: 170px;
        }

        .tagline {
          margin-top: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <div class="layout">
        <div class="saxophone">
          <img src="/saxophone.png" alt="Saxophone illustration" />
        </div>

        <div class="content">
          <h1>Jazzdrengene.dk</h1>

          <div class="phone">+45 20712237</div>

          <div class="tagline">- musik til enhver festlig lejlighed</div>

          <div class="message">
            <p>Velkommen til Jazzdrengene.dk.</p>
            <p>Vi er ved at opbygge siden.</p>
            <p>
              I mellemtiden anbefaler vi et besøg på vores bookers side:
              <a href="https://jazz-band.dk/video-lyd/" target="_blank" rel="noopener noreferrer">
                jazz-band.dk/video-lyd/
              </a>
            </p>
            <p>
              Du er også velkommen til at kontakte Claus på
              <a href="tel:+4520712237">20712237</a>.
            </p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>