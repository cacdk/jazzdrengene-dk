---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="da">
  <head>
    <BaseHead
      title="Jazzdrengene.dk | Musik til enhver festlig lejlighed"
      description="Jazzdrengene.dk - musik til enhver festlig lejlighed."
    />
    <style>
      :root {
        color-scheme: dark;
        --black: #0b0b0a;
        --white: #f4f3f0;
        --content-width: 648px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--black);
        color: var(--white);
      }

      body {
        min-height: 100vh;
        font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
      }

      main {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2.5rem 2rem;
        background: radial-gradient(ellipse at 50% 48%, #151514 0%, var(--black) 62%);
      }

      .landing {
        width: min(100%, 1344px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2.25rem;
      }

      .visual {
        position: relative;
        width: min(100%, var(--content-width));
      }

      .photo {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: auto;
        object-fit: contain;
        filter: grayscale(1) contrast(1.08) brightness(0.82);
        border: 1px solid rgba(244, 243, 240, 0.2);
        box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.38);
      }

      .bottom-photo {
        display: block;
        width: min(100%, var(--content-width));
        height: auto;
        filter: grayscale(1) contrast(1.08) brightness(0.82);
        border: 1px solid rgba(244, 243, 240, 0.2);
        box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.38);
      }

      .pool-photo {
        display: block;
        width: min(100%, var(--content-width));
        height: auto;
        filter: grayscale(1) contrast(1.08) brightness(0.68);
        border: 1px solid rgba(244, 243, 240, 0.2);
        box-shadow: 0 1.5rem 3.5rem rgba(0, 0, 0, 0.38);
      }

      .primary-info {
        width: min(100%, var(--content-width));
      }

      .title-image {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1) brightness(0) invert(1);
      }

      .copy {
        display: contents;
      }

      .message {
        width: min(100%, var(--content-width));
        position: relative;
        margin-top: 0;
        padding-top: 1.6rem;
      }

      h1 {
        margin: 0;
        color: var(--white);
        font-weight: 700;
        font-size: clamp(2.2rem, 15cqw, 6.8rem);
        line-height: 0.95;
        letter-spacing: 0.015em;
        white-space: nowrap;
      }

      .phone {
        display: block;
        margin-top: 1.5rem;
        color: var(--white);
        font-weight: 700;
        font-size: clamp(1.4rem, 7cqw, 3.5rem);
        line-height: 1;
        letter-spacing: 0.04em;
        text-decoration: none;
      }

      .tagline {
        margin: 1.15rem 0 0;
        color: var(--white);
        font-weight: 700;
        font-size: clamp(1rem, 4cqw, 1.6rem);
        line-height: 1.1;
        letter-spacing: 0.025em;
        text-transform: lowercase;
      }

      .message::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        left: 0;
        border-top: 1px solid rgba(244, 243, 240, 0.28);
      }

      .message p {
        margin: 0 0 0.9rem;
        color: rgba(244, 243, 240, 0.74);
        font-size: 1.05rem;
        line-height: 1.55;
      }

      .message a {
        color: var(--white);
        text-underline-offset: 0.18em;
      }

      .phone:hover,
      .phone:focus-visible {
        color: #c9c8c5;
      }

      @media (max-width: 680px) {
        main {
          padding: 2.5rem 1.5rem;
        }

        .visual {
          width: calc(100% - 1rem);
          margin-left: 0.5rem;
        }

        .primary-info {
          grid-template-columns: minmax(110px, 0.4fr) 1fr;
          gap: 1rem;
        }

        .saxophone {
          width: 78%;
        }

        .message {
          margin-left: 0;
        }

        .message::before {
          left: 0;
        }

        .copy {
          text-align: center;
        }

        .primary-info {
          width: min(100%, 648px);
        }
      }
    </style>
  </head>

  <body>
    <main>
      <section class="landing" aria-label="Jazzdrengene kontaktoplysninger">
        <div class="primary-info">
          <img
            class="title-image"
            src="/TitleTransparent.png"
            alt="Jazzdrengene.dk - musik til enhver festlig lejlighed"
          />
        </div>

        <div class="visual">
          <img class="photo" src="/JizzersAll.jpg" alt="Jazzdrengene spiller musik" />
        </div>

        <div class="message">
          <p>
            Vil du høre mere om os? Ring til Claus på
            <a href="tel:+4520712237">20712237</a>
          </p>
          <p>
            Book os og se billeder og video på:
            <a href="https://jazz-band.dk/video-lyd/" target="_blank" rel="noopener noreferrer">
              jazz-band.dk/video-lyd/
            </a>
          </p>
        </div>

        <img class="pool-photo" src="/JazzdrengnePool.jpg" alt="Jazzdrengene ved poolen" />

        <img class="bottom-photo" src="/Jazzdrengenebw.png" alt="Jazzdrengene spiller musik" />
      </section>
    </main>
  </body>
</html>
