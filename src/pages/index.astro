---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="da">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: #000;
        color: #fff;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      }
      main {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
      }
      .card {
        width: min(900px, 100%);
        line-height: 1.6;
      }
      h1 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        margin: 0 0 1rem 0;
      }
      p {
        font-size: 1.1rem;
        margin: 0 0 1rem 0;
      }
      a {
        color: #7dd3fc;
        text-decoration: underline;
      }
      a:hover {
        color: #bae6fd;
      }
    </style>
  </head>

  <body>
    <main>
      <div class="card">
        <h1>Velkommen til jazzdrengene.dk</h1>
        <p>Vi er ved at opbygge siden.</p>
        <p>
          I mellemtiden anbefaler vi at besøge vores bookers side på:
          <a href="https://jazz-band.dk/video-lyd/" target="_blank" rel="noopener noreferrer">
            https://jazz-band.dk/video-lyd/
          </a>
        </p>
        <p>Du er også velkomne til at kontakte Claus på <a href="tel:+4520712237">20712237</a></p>
      </div>
    </main>
  </body>
</html>